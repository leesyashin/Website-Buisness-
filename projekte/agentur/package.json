{
  "name": "agentur",
  "private": true,
  "version": "0.1.0",
  "description": "Website der eigenen Agentur: Neu bauen (Fragebogen mit Live-Skizze) und Renovieren (Schnell-Check, Vorher/Nachher), Referenzen aus beispiele/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "beispiele": "vite build ../../beispiele --base /beispiele/ --outDir \"$PWD/public/beispiele\" --emptyOutDir",
    "build": "npm run beispiele && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
